# Perl::Critic policy for perl.com.
#
# precious.toml runs `perlcritic --profile=$PRECIOUS_ROOT/perlcriticrc` but no
# such file existed, so the perlcritic command errored out. This restores it
# with Perl::Critic's gentlest baseline (severity 5 = "brutal" only), matching
# the default behavior the existing code already passes. Tighten severity or
# add [-Policy::Name] blocks here as the project adopts stricter standards.
severity = 5
